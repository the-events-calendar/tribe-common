{
	"build": [
		"composer -- pup",
		"test ! -e .git || (rm -rf vendor && git checkout -- vendor)",
		"composer install --no-dev",
		"npm ci --no-audit --no-fund",
		"npm run build"
	],
	"build_dev": [
		"composer -- pup",
		"test ! -e .git || (rm -rf vendor && git checkout -- vendor)",
		"composer install",
		"npm ci --no-audit --no-fund",
		"npm run build"
	],
	"checks": {
		"tbd": {
			"dirs": [
				"."
			],
			"skip_directories": "bin|build|vendor|node_modules|.git|.github|tests|docs|dev|__mocks__|changelog",
			"skip_files": ".min.css|.min.js|.map.js|.css|.png|.jpg|.jpeg|.svg|.gif|.ico|AGENTS.md|CLAUDE.md"
		},
		"version-conflict": {}
	},
	"i18n": [
		{
			"slug": "tribe-common",
			"textdomain": "tribe-common",
			"url": "https://translations.stellarwp.com/glotpress/"
		}
	],
	"paths": {
		"changelog": "readme.txt",
		"css": [
			"src/resources/postcss"
		],
		"js": [
			"src/resources/js",
			"src/modules"
		],
		"sync_files": [
			".distfiles",
			".gitattributes"
		],
		"versions": [
			{
				"file": "src/Tribe/Main.php",
				"regex": "(const VERSION += ')([^']+)"
			},
			{
				"file": "tribe-common.php",
				"regex": "(Version: )(.+)"
			},
			{
				"file": "package.json",
				"regex": "(\"version\": ?\")([0-9][^\"]*)"
			}
		],
		"views": [
			"src/views"
		]
	},
	"zip_use_default_ignore": false,
	"zip_name": "tribe-common"
}
